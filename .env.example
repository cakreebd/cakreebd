# PostgreSQL connection URL from your managed database provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SITE_URL="http://localhost:3000"

# Optional when testing private CV uploads locally. Vercel injects Blob access
# for a connected private Blob store in deployments.
BLOB_READ_WRITE_TOKEN=""

# Optional transactional email and scheduled job-alert delivery.
RESEND_API_KEY=""
EMAIL_FROM="Cakree <jobs@example.com>"
CRON_SECRET=""

# bKash Tokenized Checkout. Use sandbox credentials for testing.
BKASH_API_BASE_URL="https://tokenized.sandbox.bka.sh/v2/tokenized-checkout"
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_TOKEN_ENCRYPTION_KEY=""
