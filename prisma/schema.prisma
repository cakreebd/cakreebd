generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("JOB_SEEKER")
  phone        String?
  location     String?
  headline     String?
  bio          String?
  skills       String   @default("[]")
  cvFileName   String?
  cvStorageKey String?
  companyName  String?
  companyBio   String?
  website      String?
  profileVisible Boolean  @default(false)
  emailNotifications Boolean @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  jobs         Job[]
  applications JobApplication[]
  savedJobs    SavedJob[]
  jobAlerts    JobAlert[]
  notifications Notification[]
  employerPlan EmployerPlan?
  interviews   Interview[] @relation("InterviewEmployer")
  resumes      CandidateResume[]
  authoredReviews CompanyReview[] @relation("ReviewAuthor")
  companyReviews CompanyReview[] @relation("ReviewedCompany")
  paymentOrders EmployerPayment[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id             Int      @id @default(autoincrement())
  employerId     String
  title          String
  companyName    String
  category       String
  location       String
  employmentType String
  workMode       String   @default("On-site")
  salaryMin      Int?
  salaryMax      Int?
  description    String
  requirements   String
  benefits       String?
  tags           String   @default("[]")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employer       User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications   JobApplication[]
  savedBy        SavedJob[]

  @@index([status, createdAt])
  @@index([category, location, employmentType, workMode])
  @@index([employerId])
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       Int
  applicantId String
  coverLetter String?
  status      String   @default("SUBMITTED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant   User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviews  Interview[]
  review      CompanyReview? @relation("ReviewedApplication")

  @@unique([jobId, applicantId])
  @@index([applicantId, createdAt])
  @@index([jobId, createdAt])
}

model JobAlert {
  id          String   @id @default(cuid())
  userId      String
  name        String
  query       String?
  location    String?
  category    String?
  minSalary   Int?
  active      Boolean  @default(true)
  lastNotifiedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Interview {
  id              String   @id @default(cuid())
  applicationId   String
  employerId      String
  scheduledAt     DateTime
  location        String?
  meetingUrl      String?
  notes           String?
  status          String   @default("SCHEDULED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employer        User     @relation("InterviewEmployer", fields: [employerId], references: [id], onDelete: Cascade)

  @@index([applicationId, scheduledAt])
  @@index([employerId, scheduledAt])
}

model EmployerPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String   @default("FREE")
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateResume {
  id        String   @id @default(cuid())
  userId    String   @unique
  summary   String   @default("")
  targetRole String  @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections  ResumeSection[]
}

model ResumeSection {
  id          String   @id @default(cuid())
  resumeId    String
  kind        String
  title       String
  organization String?
  startDate   String?
  endDate     String?
  description String?
  sortOrder   Int      @default(0)
  resume      CandidateResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, sortOrder])
}

model CompanyReview {
  id             String   @id @default(cuid())
  applicationId  String   @unique
  authorId       String
  employerId     String
  rating         Int
  title          String
  body           String
  anonymous      Boolean  @default(false)
  status         String   @default("PENDING")
  employerResponse String?
  moderatedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  application    JobApplication @relation("ReviewedApplication", fields: [applicationId], references: [id], onDelete: Cascade)
  author         User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  company        User     @relation("ReviewedCompany", fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, status, createdAt])
  @@index([authorId, createdAt])
}

model EmployerPayment {
  id                   String   @id @default(cuid())
  userId               String
  plan                 String
  amountBdt            Int
  currency             String   @default("BDT")
  status               String   @default("PENDING")
  invoiceNumber        String   @unique
  providerPaymentId    String?  @unique
  providerTransactionId String? @unique
  checkoutUrl          String?
  failureReason        String?
  expiresAt            DateTime
  paidAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model PaymentProviderToken {
  id             String   @id @default("bkash")
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt
}

model SavedJob {
  id        String   @id @default(cuid())
  jobId     Int
  userId    String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId, createdAt])
}
